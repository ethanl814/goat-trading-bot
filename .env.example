# === Broker credentials ===
ALPACA_KEY_ID=YOUR_ALPACA_KEY_ID
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # change to live later

# === Alpaca (optional split paper/live keys; falls back to the above) ===
# ALPACA_PAPER_KEY_ID=...
# ALPACA_PAPER_SECRET_KEY=...
# ALPACA_LIVE_KEY_ID=...
# ALPACA_LIVE_SECRET_KEY=...
# ALPACA_DATA_FEED=iex            # iex (free, 15-min delayed) | sip (paid, real-time)

# === Kalshi (prediction markets) ===
# Generate an API key pair in Kalshi Settings -> API. Put the PEM in .secrets/
# (git-ignored) and point KALSHI_PRIVATE_KEY_PATH at it. NEVER commit the PEM.
KALSHI_API_KEY_ID=YOUR_KALSHI_KEY_ID
KALSHI_PRIVATE_KEY_PATH=.secrets/kalshi_private_key.pem
KALSHI_ENV=demo                    # demo (sandbox) | prod

# === SEC / EDGAR ===
# The SEC asks for an email in the User-Agent header for fair-use monitoring.
SEC_USER_AGENT="your@email.com"
